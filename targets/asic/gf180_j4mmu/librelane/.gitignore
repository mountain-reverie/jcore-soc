# LibreLane build outputs (regenerated by run.sh) — never commit
*/runs/
*.log
*/*.v
*/config.merged.json
# EXCEPTION: the top's pre-generated hierarchy netlist + blackbox stubs ARE
# committed inputs (run.sh macro=top consumes them; regen recipe in top/README.md)
!top/soc.v
!top/soc_macros_bb.v
# EXCEPTION: chip_core's flat whole-soc netlist is a committed input too
# (run.sh macro=chip_core consumes it; regen recipe in chip_core/README.md)
!chip_core/chip_core.v
# pad_ring: netlist+config are generated (bind run-output child LEFs); see pad_ring/README.md
pad_ring/config.json
pad_ring/macros/
# chip_top pad wrapper is a committed generated input (regen: chip_top/README.md)
!chip_top/chip_top.sv
